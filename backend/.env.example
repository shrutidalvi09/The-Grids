# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# MySQL 8.4. The app user needs full rights on thegrids, thegrids_test and
# thegrids_shadow (Prisma's migration shadow database).
DATABASE_URL="mysql://thegrids:PASSWORD@127.0.0.1:3306/thegrids"
SHADOW_DATABASE_URL="mysql://thegrids:PASSWORD@127.0.0.1:3306/thegrids_shadow"
TEST_DATABASE_URL="mysql://thegrids:PASSWORD@127.0.0.1:3306/thegrids_test"

# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
OTP_PEPPER=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# "console" prints OTPs to the server log. Refused when NODE_ENV=production;
# a real SMS provider (e.g. MSG91) is added before launch.
SMS_PROVIDER=console
# Dev only: also return the OTP in the API response so the dev app can show it.
# Refused when NODE_ENV=production.
OTP_DEV_ECHO=true

# Razorpay (Dashboard → Settings → API Keys; use Test Mode keys in development).
# Leave RAZORPAY_KEY_ID empty to use the simulated gateway (development only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks; events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# Push notifications (FCM): path to a Firebase service-account JSON
# (Firebase console → Project settings → Service accounts → Generate key).
# Leave empty to only save notifications in-app and log pushes.
FIREBASE_SERVICE_ACCOUNT_FILE=

# Local storage (move to object storage before production)
UPLOADS_DIR=uploads
RECEIPTS_DIR=storage/receipts
